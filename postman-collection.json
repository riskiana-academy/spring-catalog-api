{
  "info": {
    "name": "Week 10 - Spring Catalog API",
    "description": "API testing collection for Week 10 Lab - Input Validation, Java 8 & JWT Security",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login (Get JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('token', jsonData.token);",
                  "  console.log('Token saved: ' + jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \"username\": \"admin\",\\n  \"password\": \"password123\"\\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            }
          },
          "description": "Login dengan credentials admin/password123\\n\\nResponse akan berisi JWT token yang bisa disimpan ke environment variable 'token'"
        }
      ]
    },
    {
      "name": "Products - Success Cases",
      "item": [
        {
          "name": "2a. Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products"]
            }
          },
          "description": "Menampilkan daftar semua products dari database\\n\\nExpected: 200 OK dengan array products"
        },
        {
          "name": "2b. Get Product by ID (Success)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/products/PROD001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products", "PROD001"]
            }
          },
          "description": "Ambil detail product dengan ID tertentu\\n\\nExpected: 200 OK + product detail\\n\\nNote: Pastikan PROD001 sudah ada di database"
        },
        {
          "name": "3a. Create Product (Valid Data)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \"id\": \"PROD001\",\\n  \"name\": \"Laptop Gaming ASUS\",\\n  \"price\": 15000000.0\\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products"]
            }
          },
          "description": "Create product dengan data VALID\\n\\nExpected: 201 Created\\n\\nResponse berisi product yang baru dibuat"
        }
      ]
    },
